             cod = UNI_BT_COD_MAJOR_PERIPHERAL | UNI_BT_COD_MINOR_MICE;
@@ -822,10 +937,20 @@ void uni_bt_le_on_gap_event_advertising_report(const uint8_t* packet, uint16_t s
 }
 
 void uni_bt_le_on_hci_disconnection_complete(uint16_t channel, const uint8_t* packet, uint16_t size) {
+    const hci_con_handle_t con_handle = hci_event_disconnection_complete_get_connection_handle(packet);
+
     ARG_UNUSED(channel);
-    ARG_UNUSED(packet);
     ARG_UNUSED(size);
 
+    if (con_handle == switch2_pro_con_handle) {
+        btstack_run_loop_remove_timer(&switch2_pro_setup_timer);
+        if (switch2_pro_input_listener_registered) {
+            gatt_client_stop_listening_for_characteristic_value_updates(&switch2_pro_input_listener);
+            switch2_pro_input_listener_registered = false;
