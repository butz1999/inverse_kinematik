 static bool is_scanning;
 static bool ble_enabled;
+static btstack_timer_source_t switch2_pro_setup_timer;
+static hci_con_handle_t switch2_pro_con_handle = UNI_BT_CONN_HANDLE_INVALID;
+static gatt_client_characteristic_t switch2_pro_input_characteristic;
+static gatt_client_notification_t switch2_pro_input_listener;
+static bool switch2_pro_input_listener_registered;
+
+#define SWITCH2_PRO_INPUT_VALUE_HANDLE 0x002e
+#define SWITCH2_PRO_INPUT_CCCD_HANDLE 0x002f
+#define SWITCH2_PRO_INPUT_REPORT_MIN_SIZE 63
 
 // Temporal space for SDP in BLE
 static uint8_t hid_descriptor_storage[HID_MAX_DESCRIPTOR_LEN * CONFIG_BLUEPAD32_MAX_DEVICES];
 static btstack_packet_callback_registration_t sm_event_callback_registration;
 
+extern void ik_switch2_pro_ble_input_report(const uint8_t* report, uint16_t report_size);
+
+static bool is_switch2_pro_address(bd_addr_t addr) {
+    return strcmp(bd_addr_to_str(addr), "A4:C1:E8:50:BC:2B") == 0;
+}
+
+static void switch2_pro_input_notification_handler(uint8_t packet_type,
+                                                    uint16_t channel,
+                                                    uint8_t* packet,
+                                                    uint16_t size) {
+    ARG_UNUSED(packet_type);
+    ARG_UNUSED(channel);
+    ARG_UNUSED(size);
+
+    if (hci_event_packet_get_type(packet) != GATT_EVENT_NOTIFICATION)
+        return;
+
+    const uint16_t value_handle = gatt_event_notification_get_value_handle(packet);
+    const uint16_t value_len = gatt_event_notification_get_value_length(packet);
+    const uint8_t* value = gatt_event_notification_get_value(packet);
+    if (value_handle == SWITCH2_PRO_INPUT_VALUE_HANDLE && value_len >= SWITCH2_PRO_INPUT_REPORT_MIN_SIZE &&
+        value[1] == 0x20) {
+        ik_switch2_pro_ble_input_report(value, value_len);
+    }
+}
+
+static void switch2_pro_enable_notifications_handler(uint8_t packet_type,
+                                                      uint16_t channel,
+                                                      uint8_t* packet,
+                                                      uint16_t size) {
+    ARG_UNUSED(packet_type);
+    ARG_UNUSED(channel);
+    ARG_UNUSED(size);
+
+    if (hci_event_packet_get_type(packet) != GATT_EVENT_QUERY_COMPLETE)
+        return;
+
+    if (gatt_event_query_complete_get_att_status(packet) != ATT_ERROR_SUCCESS) {
+        loge("Switch 2 Pro input notification setup failed: ATT status 0x%02x\n",
+             gatt_event_query_complete_get_att_status(packet));
+    }
+}
+
+static void switch2_pro_setup_timer_handler(btstack_timer_source_t* ts) {
+    uint8_t status;
+    static uint8_t notification_enabled[] = {0x01, 0x00};
+
+    ARG_UNUSED(ts);
+
+    if (switch2_pro_con_handle == UNI_BT_CONN_HANDLE_INVALID)
+        return;
+
+    memset(&switch2_pro_input_characteristic, 0, sizeof(switch2_pro_input_characteristic));
+    switch2_pro_input_characteristic.value_handle = SWITCH2_PRO_INPUT_VALUE_HANDLE;
+    gatt_client_listen_for_characteristic_value_updates(&switch2_pro_input_listener,
+                                                         switch2_pro_input_notification_handler,
+                                                         switch2_pro_con_handle,
+                                                         &switch2_pro_input_characteristic);
+    switch2_pro_input_listener_registered = true;
+    status = gatt_client_write_characteristic_descriptor_using_descriptor_handle(
+        switch2_pro_enable_notifications_handler, switch2_pro_con_handle, SWITCH2_PRO_INPUT_CCCD_HANDLE,
+        sizeof(notification_enabled), notification_enabled);
+    if (status != ERROR_CODE_SUCCESS) {
+        gatt_client_stop_listening_for_characteristic_value_updates(&switch2_pro_input_listener);
+        switch2_pro_input_listener_registered = false;
+        loge("Switch 2 Pro input notification request failed: status 0x%02x\n", status);
+    }
+}
+
+static void switch2_pro_schedule_input_setup(hci_con_handle_t con_handle) {
+    switch2_pro_con_handle = con_handle;
+    btstack_run_loop_set_timer_context(&switch2_pro_setup_timer, NULL);
+    btstack_run_loop_set_timer_handler(&switch2_pro_setup_timer, switch2_pro_setup_timer_handler);
+    btstack_run_loop_set_timer(&switch2_pro_setup_timer, 250);
+    btstack_run_loop_add_timer(&switch2_pro_setup_timer);
+}
+
+void uni_bt_le_switch2_pro_disconnect(void) {
+    const hci_con_handle_t con_handle = switch2_pro_con_handle;
+    if (con_handle == UNI_BT_CONN_HANDLE_INVALID)
+        return;
+
+    btstack_run_loop_remove_timer(&switch2_pro_setup_timer);
+    if (switch2_pro_input_listener_registered) {
+        gatt_client_stop_listening_for_characteristic_value_updates(&switch2_pro_input_listener);
+        switch2_pro_input_listener_registered = false;
+    }
+    switch2_pro_con_handle = UNI_BT_CONN_HANDLE_INVALID;
+    if (gap_get_connection_type(con_handle) != GAP_CONNECTION_INVALID)
+        gap_disconnect(con_handle);
+}
+
+bool uni_bt_le_switch2_pro_is_connected(void) {
+    return switch2_pro_con_handle != UNI_BT_CONN_HANDLE_INVALID &&
+           gap_get_connection_type(switch2_pro_con_handle) != GAP_CONNECTION_INVALID;
+}
+
 /**
  * Connect to remote device but set timer for timeout
  */
@@ -701,6 +807,11 @@ void uni_bt_le_on_hci_event_le_meta(const uint8_t* packet, uint16_t size) {
             logi("Using con_handle: %#x\n", con_handle);
 
