{
  "openapi": "3.1.0",
  "info": {
    "title": "Inverse Kinematic REST API",
    "version": "v1",
    "description": "Current HTTP/JSON interface of the ESP32-S3 firmware. Authentication is deliberately not part of this embedded firmware API."
  },
  "servers": [
    {"url": "http://robot.local"}
  ],
  "paths": {
    "/api/health": {"get": {"operationId": "getHealth", "responses": {"200": {"description": "Health response", "content": {"application/json": {"schema": {"$ref": "#/$defs/HealthResponse"}}}}}}},
    "/api/status": {"get": {"operationId": "getStatus", "responses": {"200": {"description": "Capability status", "content": {"application/json": {"schema": {"$ref": "#/$defs/StatusResponse"}}}}}}},
    "/api/settings/motion-limits": {"get": {"operationId": "getMotionLimits", "responses": {"200": {"description": "Configured limits", "content": {"application/json": {"schema": {"$ref": "#/$defs/MotionLimitsResponse"}}}}}}},
    "/api/joint-state": {"get": {"operationId": "getJointState", "responses": {"200": {"description": "Assumed joint state", "content": {"application/json": {"schema": {"$ref": "#/$defs/JointStateResponse"}}}}}}},
    "/api/joint-pwm-state": {"get": {"operationId": "getJointPwmState", "responses": {"200": {"description": "Assumed or driver PWM state", "content": {"application/json": {"schema": {"$ref": "#/$defs/JointPwmStateResponse"}}}}}}},
    "/api/servo-driver/init": {"post": {"operationId": "initializeServoDriver", "responses": {"202": {"description": "Driver initialized", "content": {"application/json": {"schema": {"$ref": "#/$defs/HardwareAcceptedResponse"}}}}, "503": {"$ref": "#/$defs/responses/HardwareFailure"}}}},
    "/api/joint-motion": {"post": {"operationId": "setJointMotion", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/$defs/JointState"}}}}, "responses": {"202": {"description": "Joint target accepted", "content": {"application/json": {"schema": {"$ref": "#/$defs/HardwareAcceptedResponse"}}}}, "400": {"$ref": "#/$defs/responses/Rejected"}, "503": {"$ref": "#/$defs/responses/HardwareFailure"}}}},
    "/api/joint-pwm-motion": {"post": {"operationId": "setJointPwmMotion", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/$defs/JointPwmState"}}}}, "responses": {"202": {"description": "PWM target accepted", "content": {"application/json": {"schema": {"$ref": "#/$defs/HardwareAcceptedResponse"}}}}, "400": {"$ref": "#/$defs/responses/Rejected"}, "503": {"$ref": "#/$defs/responses/HardwareFailure"}}}},
    "/api/motion": {"post": {"operationId": "startMotion", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/$defs/MotionRequest"}}}}, "responses": {"202": {"description": "Task-space motion accepted", "content": {"application/json": {"schema": {"$ref": "#/$defs/MotionAcceptedResponse"}}}}, "400": {"$ref": "#/$defs/responses/Rejected"}, "409": {"$ref": "#/$defs/responses/Busy"}, "422": {"$ref": "#/$defs/responses/Rejected"}, "503": {"$ref": "#/$defs/responses/HardwareFailure"}}}},
    "/api/forward-kinematics": {"post": {"operationId": "forwardKinematics", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/$defs/JointState"}}}}, "responses": {"200": {"description": "Calculated target pose", "content": {"application/json": {"schema": {"$ref": "#/$defs/ForwardKinematicsResponse"}}}}, "400": {"$ref": "#/$defs/responses/Rejected"}}}},
    "/api/sequence/start": {"post": {"operationId": "startSequence", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/$defs/SequenceRequest"}}}}, "responses": {"202": {"description": "Sequence accepted", "content": {"application/json": {"schema": {"$ref": "#/$defs/SequenceResponse"}}}}, "400": {"$ref": "#/$defs/responses/Rejected"}, "409": {"$ref": "#/$defs/responses/Busy"}, "422": {"$ref": "#/$defs/responses/Rejected"}, "503": {"$ref": "#/$defs/responses/HardwareFailure"}}}},
    "/api/sequence/stop": {"post": {"operationId": "stopSequence", "responses": {"202": {"description": "Sequence stopped", "content": {"application/json": {"schema": {"$ref": "#/$defs/SequenceResponse"}}}}}}},
    "/api/sequence/status": {"get": {"operationId": "getSequenceStatus", "responses": {"200": {"description": "Sequence state", "content": {"application/json": {"schema": {"$ref": "#/$defs/SequenceResponse"}}}}}}},
    "/api/controller/connect": {"post": {"operationId": "connectController", "responses": {"202": {"description": "Pairing requested", "content": {"application/json": {"schema": {"$ref": "#/$defs/ControllerResponse"}}}}}}},
    "/api/controller/disconnect": {"post": {"operationId": "disconnectController", "responses": {"202": {"description": "Controller disconnected", "content": {"application/json": {"schema": {"$ref": "#/$defs/ControllerResponse"}}}}}}},
    "/api/controller/status": {"get": {"operationId": "getControllerStatus", "responses": {"200": {"description": "Controller state", "content": {"application/json": {"schema": {"$ref": "#/$defs/ControllerResponse"}}}}}}},
    "/api/controller/debug": {"get": {"operationId": "getControllerDebug", "responses": {"200": {"description": "Controller diagnostics", "content": {"application/json": {"schema": {"$ref": "#/$defs/ControllerResponse"}}}}}}}
  },
  "$defs": {
    "JointState": {"type": "object", "required": ["d_deg", "s_deg", "e_deg", "hp_deg", "hr_deg", "g_pct"], "properties": {"d_deg": {"type": "number"}, "s_deg": {"type": "number"}, "e_deg": {"type": "number"}, "hp_deg": {"type": "number"}, "hr_deg": {"type": "number"}, "g_pct": {"type": "number", "minimum": 0, "maximum": 100}}, "additionalProperties": true},
    "JointPwmState": {"type": "object", "required": ["d_pwm", "s_pwm", "e_pwm", "hp_pwm", "hr_pwm", "g_pwm"], "properties": {"d_pwm": {"type": "integer", "minimum": 0, "maximum": 4095}, "s_pwm": {"type": "integer", "minimum": 0, "maximum": 4095}, "e_pwm": {"type": "integer", "minimum": 0, "maximum": 4095}, "hp_pwm": {"type": "integer", "minimum": 0, "maximum": 4095}, "hr_pwm": {"type": "integer", "minimum": 0, "maximum": 4095}, "g_pwm": {"type": "integer", "minimum": 0, "maximum": 4095}}, "additionalProperties": true},
    "TargetPose": {"type": "object", "required": ["x_mm", "y_mm", "z_mm", "p_deg", "r_deg", "g_pct"], "properties": {"x_mm": {"type": "number"}, "y_mm": {"type": "number"}, "z_mm": {"type": "number"}, "p_deg": {"type": "number"}, "r_deg": {"type": "number"}, "g_pct": {"type": "number", "minimum": 0, "maximum": 100}}, "additionalProperties": true},
    "MotionProfile": {"type": "object", "properties": {"type": {"type": "string", "enum": ["constant_velocity", "constant_acceleration", "smooth_start_stop", "fast_start_stop"]}, "target_velocity_deg_s": {"type": "number"}, "sample_time_ms": {"type": "integer", "minimum": 0}}, "additionalProperties": true},
    "MotionRequest": {"allOf": [{"$ref": "#/$defs/TargetPose"}, {"type": "object", "properties": {"motionProfile": {"$ref": "#/$defs/MotionProfile"}}}]},
    "SequenceRequest": {"type": "object", "required": ["steps"], "properties": {"steps": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"oneOf": [{"$ref": "#/$defs/PoseStep"}, {"$ref": "#/$defs/WaitStep"}, {"$ref": "#/$defs/LedStep"}]}}}},
    "PoseStep": {"type": "object", "required": ["type"], "properties": {"type": {"const": "pose"}, "name": {"type": "string"}, "targetPose": {"$ref": "#/$defs/TargetPose"}, "x_mm": {"type": "number"}, "y_mm": {"type": "number"}, "z_mm": {"type": "number"}, "p_deg": {"type": "number"}, "r_deg": {"type": "number"}, "g_pct": {"type": "number", "minimum": 0, "maximum": 100}, "motionProfile": {"$ref": "#/$defs/MotionProfile"}}, "allOf": [{"anyOf": [{"required": ["targetPose"]}, {"required": ["x_mm", "y_mm", "z_mm", "p_deg", "r_deg", "g_pct"]}]}]},
    "WaitStep": {"type": "object", "required": ["type"], "properties": {"type": {"const": "wait"}, "duration_ms": {"type": "integer", "minimum": 0}, "wait_ms": {"type": "integer", "minimum": 0}}, "anyOf": [{"required": ["duration_ms"]}, {"required": ["wait_ms"]}]},
    "LedStep": {"type": "object", "required": ["type", "mode", "interval_ms"], "properties": {"type": {"const": "led"}, "name": {"type": "string"}, "mode": {"type": "string", "enum": ["off", "on", "blinking", "pulsing"]}, "interval_ms": {"type": "integer", "minimum": 1}, "color": {"type": "string", "enum": ["off", "red", "orange", "yellow", "green", "cyan", "blue", "violet"]}, "rgb": {"type": "object", "required": ["r", "g", "b"], "properties": {"r": {"type": "integer", "minimum": 0, "maximum": 255}, "g": {"type": "integer", "minimum": 0, "maximum": 255}, "b": {"type": "integer", "minimum": 0, "maximum": 255}}}, "r": {"type": "integer", "minimum": 0, "maximum": 255}, "g": {"type": "integer", "minimum": 0, "maximum": 255}, "b": {"type": "integer", "minimum": 0, "maximum": 255}}, "oneOf": [{"required": ["color"]}, {"required": ["rgb"]}, {"required": ["r", "g", "b"]}]},
    "ApiResponse": {"type": "object", "required": ["status", "code"], "properties": {"status": {"type": "string"}, "code": {"type": "string"}, "field": {"type": "string"}, "message": {"type": "string"}}, "additionalProperties": true},
    "HealthResponse": {"allOf": [{"$ref": "#/$defs/ApiResponse"}, {"type": "object", "required": ["api", "version"], "properties": {"status": {"const": "ok"}, "code": {"const": "ok"}, "api": {"const": "inverse_kinematic"}, "version": {"const": "v1"}}}]},
    "StatusResponse": {"allOf": [{"$ref": "#/$defs/ApiResponse"}, {"type": "object", "properties": {"restApi": {"type": "string"}, "motionEndpoint": {"type": "string"}, "uptimeMs": {"type": "integer", "minimum": 0}}}]},
    "JointStateResponse": {"allOf": [{"$ref": "#/$defs/ApiResponse"}, {"type": "object", "required": ["jointState"], "properties": {"jointState": {"$ref": "#/$defs/JointState"}, "source": {"type": "string"}}}]},
    "JointPwmStateResponse": {"allOf": [{"$ref": "#/$defs/ApiResponse"}, {"type": "object", "required": ["jointPwmState"], "properties": {"jointPwmState": {"$ref": "#/$defs/JointPwmState"}, "source": {"type": "string"}}}]},
    "MotionLimitsResponse": {"$ref": "#/$defs/ApiResponse"},
    "HardwareAcceptedResponse": {"allOf": [{"$ref": "#/$defs/ApiResponse"}, {"type": "object", "properties": {"status": {"const": "accepted"}, "jointState": {"$ref": "#/$defs/JointState"}, "jointPwmState": {"$ref": "#/$defs/JointPwmState"}}}]},
    "MotionAcceptedResponse": {"allOf": [{"$ref": "#/$defs/HardwareAcceptedResponse"}, {"type": "object", "properties": {"targetPose": {"$ref": "#/$defs/TargetPose"}, "motionPlan": {"type": "object"}}}]},
    "ForwardKinematicsResponse": {"allOf": [{"$ref": "#/$defs/ApiResponse"}, {"type": "object", "required": ["jointState", "targetPose"], "properties": {"jointState": {"$ref": "#/$defs/JointState"}, "targetPose": {"$ref": "#/$defs/TargetPose"}}}]},
    "SequenceResponse": {"$ref": "#/$defs/ApiResponse"},
    "ControllerResponse": {"allOf": [{"$ref": "#/$defs/ApiResponse"}, {"type": "object", "required": ["controller"], "properties": {"controller": {"type": "object"}}}]},
    "responses": {"Rejected": {"description": "Validation or parse failure", "content": {"application/json": {"schema": {"$ref": "#/$defs/ApiResponse"}}}}, "Busy": {"description": "Motion or sequence already active", "content": {"application/json": {"schema": {"$ref": "#/$defs/ApiResponse"}}}}, "HardwareFailure": {"description": "Hardware unavailable or failed", "content": {"application/json": {"schema": {"$ref": "#/$defs/ApiResponse"}}}}}
  }
}
